### Calculate invoice subtotal
POST http://localhost:8080/api/v1/billing/calculate
Content-Type: application/json

{
  "items": [
    {
      "itemType": "LABOUR",
      "description": "Oil-change labour",
      "quantity": 1,
      "unitPrice": 1500.00
    },
    {
      "itemType": "PART",
      "description": "Engine oil",
      "quantity": 2.5,
      "unitPrice": 2000.00
    }
  ]
}

### Retrieve an invoice
GET http://localhost:8080/api/v1/billing/invoices/1
Authorization: Basic {{billingUsername}} {{billingPassword}}

### List service jobs
GET http://localhost:8080/api/service-jobs
Authorization: Basic {{billingUsername}} {{billingPassword}}

### Get one service job
GET http://localhost:8080/api/service-jobs/{{testJobId}}
Authorization: Basic {{billingUsername}} {{billingPassword}}

### Get labour lines for the job
GET http://localhost:8080/api/service-job-items/job/{{testJobId}}
Authorization: Basic {{billingUsername}} {{billingPassword}}

### Get part lines for the job
GET http://localhost:8080/api/service-job-parts/job/{{testJobId}}
Authorization: Basic {{billingUsername}} {{billingPassword}}

### Login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "{{billingUsername}}",
  "password": "{{billingPassword}}"
}

> {%
    client.test("Login succeeds", function () {
        client.assert(response.status === 200, "Login failed");
        client.assert(
            Boolean(response.body.accessToken),
            "Access token is missing"
        );
    });

    if (response.status === 200 && response.body.accessToken) {
        client.global.set("billingToken", response.body.accessToken);
    }
%}

### Load job details
GET http://localhost:8080/api/service-jobs/{{testJobId}}
Authorization: Bearer {{billingToken}}

### Load job labour
GET http://localhost:8080/api/service-job-items/job/{{testJobId}}
Authorization: Bearer {{billingToken}}

### Load job parts
GET http://localhost:8080/api/service-job-parts/job/{{testJobId}}
Authorization: Bearer {{billingToken}}

### Retrieve invoice
GET http://localhost:8080/api/v1/billing/invoices/1
Authorization: Bearer {{billingToken}}

### List invoices
GET http://localhost:8080/api/v1/billing/invoices?page=0&size=20

### Filter by customer and status
GET http://localhost:8080/api/v1/billing/invoices?customerId=2&status=DRAFT

### Filter by job
GET http://localhost:8080/api/v1/billing/invoices?serviceJobId=10