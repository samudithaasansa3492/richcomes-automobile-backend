# Template ONLY. Do NOT put real secrets in a Git commit, issue or chat.
# Values are configured in the hosting platform's protected environment variables.
PORT=8080

# Supabase Postgres JDBC connection to intended environment AFTER V15-V23 migration.
# Use the dashboard-provided TLS-enabled connection details and protected credentials.
DB_URL=jdbc:postgresql://<approved-db-host>:5432/postgres?sslmode=verify-full
DB_USERNAME=<separately-provisioned-application-role>
DB_PASSWORD=<configure-as-host-secret>

# RS256 issuer/audience & path to secrets mounted at runtime.
JWT_ISSUER=https://<approved-app-origin>
JWT_AUDIENCE=richcomes-api
JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt-public.pem
JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/jwt-private.pem
# Railway alternative (both required, configured only as protected runtime vars):
# JWT_PUBLIC_KEY_PEM_BASE64=<base64-of-X509-public-PEM>
# JWT_PRIVATE_KEY_PEM_BASE64=<base64-of-PKCS8-private-PEM>
# Never enable both modes in a real deployment and never commit actual keys.

# NORMAL app services must never auto-migrate or invite customers on startup.
FLYWAY_ENABLED=false
CUSTOMER_ONBOARDING_ENABLED=false

# Recovery delivery is opt-in after verified HTTPS and production SMTP setup.
APP_RECOVERY_ENABLED=false
APP_RECOVERY_PAGE=https://<approved-app-origin>/account-setup.html
APP_RECOVERY_FROM=no-reply@<approved-mail-domain>
SPRING_MAIL_HOST=<approved-smtp-host>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<host-secret>
SPRING_MAIL_PASSWORD=<host-secret>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
